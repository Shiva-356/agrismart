# URL to external Spring Boot / backend API service (runs on port 8081 locally)
VITE_AGRISMART_API_URL=http://localhost:8081

# Optional URL to external FastAPI ML service (runs on port 8000)
AGRISMART_ML_API_URL=http://localhost:8000

# Optional Weather API keys (Open-Meteo OpenAPI is active by default with zero key required)
VITE_WEATHER_API_KEY=
VITE_OPENWEATHER_API_KEY=
